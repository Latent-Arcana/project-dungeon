<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/MenuStyleSheet.uss?fileID=7433441132597879392&amp;guid=8622666c0c77f81419510e23e5912e27&amp;type=3#MenuStyleSheet" />
    <ui:VisualElement name="Container" class="menu-container-main" style="flex-grow: 1; background-color: rgb(0, 0, 0); -unity-background-image-tint-color: rgb(0, 0, 0);">
        <ui:VisualElement name="BuyScreenContainer" style="flex-grow: 1; display: flex;">
            <ui:Label tabindex="-1" text="Choose Your Cartographer&apos;s Pack" parse-escape-sequences="true" display-tooltip-when-elided="true" name="BuyScreenTitle" class="text-title-main-menu" style="display: flex;" />
            <ui:VisualElement name="CartosGroup" style="align-items: flex-start; margin-left: 50px;">
                <ui:Label tabindex="-1" text="Cartos:" parse-escape-sequences="true" display-tooltip-when-elided="true" name="Cartos" class="end-game-stats-text" />
            </ui:VisualElement>
            <ui:VisualElement name="ButtonGroup" class="button-container" style="flex-grow: 1;">
                <ui:Button text="Basic Weapon Pack" parse-escape-sequences="true" display-tooltip-when-elided="true" name="BasicWeaponPack" class="menu-button" style="padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;" />
                <ui:Button text="Basic Armor Pack" parse-escape-sequences="true" display-tooltip-when-elided="true" name="BasicArmorPack" class="menu-button" />
                <ui:Button text="Advanced Weapon Pack" parse-escape-sequences="true" display-tooltip-when-elided="true" name="AdvancedWeaponPack" class="menu-button" />
                <ui:Button text="Advanced Armor Pack" parse-escape-sequences="true" display-tooltip-when-elided="true" name="AdvancedArmorPack" class="menu-button" />
                <ui:Button text="Alchemist&apos;s Pack" parse-escape-sequences="true" display-tooltip-when-elided="true" name="AlchemistPack" class="menu-button" />
                <ui:Button text="Healer&apos;s Pack" parse-escape-sequences="true" display-tooltip-when-elided="true" name="HealerPack" class="menu-button" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
